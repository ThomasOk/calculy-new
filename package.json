{
  "name": "calculy",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/repo-name.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "android": "pnpm --filter @calculy/mobile android",
    "ios": "pnpm --filter @calculy/mobile ios",
    "dev": "pnpm --filter @calculy/mobile start",
    "lint": "pnpm --recursive --if-present lint",
    "type-check": "pnpm --recursive --if-present type-check",
    "test": "pnpm --recursive --if-present test",
    "test:ci": "pnpm --recursive --if-present test:ci",
    "check": "pnpm lint && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3"
  }
}
